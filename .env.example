# MLB Quant Ops
# Institutional environment template
# Copy to .env for local/shared use. Never commit real secrets.

## APP
PORT=8787
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

## FRONTEND
# Public browser-facing variables used by Vite.
VITE_API_URL=
VITE_REFRESH_INTERVAL=120000
VITE_HOME_MOCK_DATA=true

## PIPELINES
SNAPSHOT_INTERVAL_SECONDS=75
MARKET_REFRESH_POLICY=market_watch
ENABLE_RESEARCH_PIPELINES=true
ENABLE_CIO_LAYER=true

## STORAGE
# Use SQLite or a future hosted database. Keep placeholders only here.
DATABASE_URL=
SQLITE_PATH=./data/mlb-quant-ops.sqlite
ARTIFACTS_PATH=./mlb_ops
LOGS_PATH=./mlb_ops/logs

## APIs / DATA SOURCES
MLB_STATS_API_BASE=https://statsapi.mlb.com/api/v1
BASEBALL_SAVANT_BASE=https://baseballsavant.mlb.com
ROTOWIRE_BASE=https://www.rotowire.com
COVERS_BASE=https://www.covers.com
OPEN_METEO_BASE=https://api.open-meteo.com/v1

## PLAYWRIGHT
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_BROWSER=chromium

## FEATURE FLAGS
ENABLE_DECISION_PANEL=true
ENABLE_EXECUTIVE_MEMOS=true
ENABLE_PORTFOLIO_GOVERNANCE=true
ENABLE_TEMPORAL_RESEARCH=true

## OLLAMA (local inference — no API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_FAST=qwen3:8b
OLLAMA_MODEL_REASON=qwen3:32b
OLLAMA_MODEL_MATH=deepseek-r1:32b
OLLAMA_MODEL_VISION=llama3.2-vision:11b

## JOURNAL SYNC
JOURNAL_API_URL=https://project-journal-view.lovable.app/api/journal/entries
JOURNAL_API_KEY=

## OPTIONAL RUNTIME CONTROLS
AUTO_DAILY_BOOTSTRAP=1
AUTO_BOOTSTRAP_INTERVAL_MINUTES=15
AUTO_BOOTSTRAP_FORCE=1
VITE_DEV_PORT=5173
