# MLB Quant Ops
# Production environment template
# Use platform-managed secrets and variables. Do not commit real values.

## APP
PORT=8787
NODE_ENV=production
APP_ENV=production
LOG_LEVEL=info

## FRONTEND
# Set this to the public API origin when frontend and backend are split.
# Leave empty when served from the same origin.
VITE_API_URL=
VITE_REFRESH_INTERVAL=120000
VITE_DEV_PORT=5173

## PIPELINES
SNAPSHOT_INTERVAL_SECONDS=75
MARKET_REFRESH_POLICY=market_watch
ENABLE_RESEARCH_PIPELINES=true
ENABLE_CIO_LAYER=true
AUTO_DAILY_BOOTSTRAP=0

## STORAGE
# Replace with your production storage choices.
DATABASE_URL=
SQLITE_PATH=/var/lib/mlb-quant-ops/mlb-quant-ops.sqlite
ARTIFACTS_PATH=/var/lib/mlb-quant-ops/artifacts
LOGS_PATH=/var/log/mlb-quant-ops

## APIs / DATA SOURCES
MLB_STATS_API_BASE=https://statsapi.mlb.com/api/v1
BASEBALL_SAVANT_BASE=https://baseballsavant.mlb.com
ROTOWIRE_BASE=https://www.rotowire.com
COVERS_BASE=https://www.covers.com
OPEN_METEO_BASE=https://api.open-meteo.com/v1

## PLAYWRIGHT
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=45000
PLAYWRIGHT_BROWSER=chromium

## FEATURE FLAGS
ENABLE_DECISION_PANEL=true
ENABLE_EXECUTIVE_MEMOS=true
ENABLE_PORTFOLIO_GOVERNANCE=true
ENABLE_TEMPORAL_RESEARCH=true

